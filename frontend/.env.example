# Base URL of the Raidian backend API. Vite only exposes environment
# variables prefixed with VITE_ to client code.
#
# Local development default matches the backend's own default `uvicorn`
# port (see backend/README or `uvicorn app.main:app`). Any real
# deployment must override this with the deployed backend's actual
# origin -- copy this file to `.env` (gitignored) and adjust as needed.
VITE_API_BASE_URL=http://localhost:8000
